<Window x:Class="AddinVeMong.Views.ConcentricRebarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:lang="clr-namespace:AddinVeMong.Resources.Localization"
        mc:Ignorable="d"
        Title="{x:Static lang:Resource.WindowTitle}" Height="680" Width="980" 
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundColor}" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AddinVeMong;component/Resources/Styles/LightTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/AddinVeMong;component/Resources/Styles/TextBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Tìm đến đoạn này trong Window.Resources của file ConcentricRebarView.xaml -->
            <DataTemplate x:Key="PreviewTemplate">
                <Border Padding="10" Background="{DynamicResource ControlBackgroundColor}" CornerRadius="5" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" VerticalAlignment="Stretch" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{x:Static lang:Resource.ElevationView}" Foreground="{DynamicResource TextPrimaryColor}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="canvas1" Width="400" Height="400" Background="White">
                                <!-- 1. Đường viền bê tông móng và cổ cột -->
                                <Path x:Name="PathProfile" Fill="#EAEAEA" Stroke="#555555" StrokeThickness="2" ToolTip="Khối móng và cổ cột"/>

                                <!-- 2. Thép đai rải trong cổ cột -->
                                <Path x:Name="PathStirrup" Stroke="Red" StrokeThickness="1.5" ToolTip="Thép đai cổ cột"/>

                                <!-- 3. Thép dọc cạnh dài (Thanh màu đỏ chạy ngang đáy) -->
                                <Path x:Name="PathLongRebar" Stroke="Red" StrokeThickness="3" ToolTip="{x:Static lang:Resource.SecLongBar}"/>

                                <!-- 4. Thép dọc cạnh ngắn-->
                                <Path x:Name="PathShortRebar" Fill="Red" Stroke="Red" StrokeThickness="1" ToolTip="{x:Static lang:Resource.SecShortBar}"/>

                                <!-- 5. Thép chờ cổ cột (2 thanh bẻ) -->
                                <Path x:Name="PathColumnRebar" Stroke="Red" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" ToolTip="Thép chờ cổ cột"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0,1,0,0" Margin="0,0,0,10">
            <TabItem Header="{x:Static lang:Resource.SecLongBar}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="350" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <Grid Margin="10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{x:Static lang:Resource.HeaderGeneral}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Foreground="{DynamicResource TextPrimaryColor}" FontWeight="Bold" FontSize="14" Margin="5,5,0,10"/>
                            <TextBlock Text="{x:Static lang:Resource.ConcreteCover}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.Cover, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="5,4" Tag="Mặc định: 50" Style="{StaticResource PlaceholderTextBoxStyle}" VerticalContentAlignment="Center"/>

                            <TextBlock Text="{x:Static lang:Resource.SecLongBar}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Foreground="{DynamicResource TextPrimaryColor}" FontWeight="Bold" FontSize="14" Margin="5,5,0,10"/>

                            <TextBlock Text="{x:Static lang:Resource.Diameter}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <ComboBox SelectedValue="{Binding RebarData.LongDiameter}" Grid.Row="4" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center">
                                <sys:Int32>10</sys:Int32>
                                <sys:Int32>12</sys:Int32>
                                <sys:Int32>14</sys:Int32>
                                <sys:Int32>16</sys:Int32>
                                <sys:Int32>18</sys:Int32>
                                <sys:Int32>20</sys:Int32>
                            </ComboBox>

                            <TextBlock Text="{x:Static lang:Resource.Spacing}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.LongSpacing, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>

                            <TextBlock Text="{x:Static lang:Resource.Quantity}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.LongQuantity, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>

                            <TextBlock Text="{x:Static lang:Resource.HookLength}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.LongHookLength, UpdateSourceTrigger=PropertyChanged}" Grid.Row="7" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>

                            <TextBlock Text="{x:Static lang:Resource.SecShortBar}" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Foreground="{DynamicResource TextPrimaryColor}" FontWeight="Bold" FontSize="14" Margin="5,5,0,10"/>

                            <TextBlock Text="{x:Static lang:Resource.Diameter}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <ComboBox SelectedValue="{Binding RebarData.ShortDiameter}" Grid.Row="10" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center">
                                <sys:Int32>10</sys:Int32>
                                <sys:Int32>12</sys:Int32>
                                <sys:Int32>14</sys:Int32>
                                <sys:Int32>16</sys:Int32>
                                <sys:Int32>18</sys:Int32>
                                <sys:Int32>20</sys:Int32>
                            </ComboBox>

                            <TextBlock Text="{x:Static lang:Resource.Spacing}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="11" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.ShortSpacing, UpdateSourceTrigger=PropertyChanged}" Grid.Row="11" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>

                            <TextBlock Text="{x:Static lang:Resource.Quantity}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="12" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.ShortQuantity, UpdateSourceTrigger=PropertyChanged}" Grid.Row="12" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>

                            <TextBlock Text="{x:Static lang:Resource.HookLength}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="13" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.ShortHookLength, UpdateSourceTrigger=PropertyChanged}" Grid.Row="13" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>
                        </Grid>
                    </ScrollViewer>
                    <ContentControl Grid.Column="1" ContentTemplate="{StaticResource PreviewTemplate}"/>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static lang:Resource.SecColumn}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="350" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <Grid Margin="10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Static lang:Resource.ColWidthX}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.ColumnWidthX, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center" Tag="(Ví dụ: 220, 300)" Style="{StaticResource PlaceholderTextBoxStyle}"/>
                            <TextBlock Text="{x:Static lang:Resource.ColWidthY}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.ColumnWidthY, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center" Tag="(Ví dụ: 220, 400)" Style="{StaticResource PlaceholderTextBoxStyle}"/>
                            <TextBlock Text="{x:Static lang:Resource.MainDiameter}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <ComboBox SelectedValue="{Binding RebarData.StarterDiameter}" Grid.Row="2" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center">
                                <sys:Int32>16</sys:Int32>
                                <sys:Int32>18</sys:Int32>
                                <sys:Int32>20</sys:Int32>
                                <sys:Int32>22</sys:Int32>
                                <sys:Int32>25</sys:Int32>
                            </ComboBox>
                            <TextBlock Text="{x:Static lang:Resource.FootHookLength}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.StarterHookLength, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{x:Static lang:Resource.StarterLength}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.StarterLength, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{x:Static lang:Resource.StirrupDiameter}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <ComboBox SelectedValue="{Binding RebarData.StirrupDiameter}" Grid.Row="5" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center">
                                <sys:Int32>6</sys:Int32>
                                <sys:Int32>8</sys:Int32>
                                <sys:Int32>10</sys:Int32>
                            </ComboBox>
                            <TextBlock Text="{x:Static lang:Resource.StirrupSpacing}" Foreground="{DynamicResource TextPrimaryColor}" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                            <TextBox Text="{Binding RebarData.StirrupSpacing, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>
                        </Grid>
                    </ScrollViewer>
                    <ContentControl Grid.Column="1" ContentTemplate="{StaticResource PreviewTemplate}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="{x:Static lang:Resource.BtnCancel}" Style="{StaticResource {x:Type Button}}" Background="{DynamicResource SecondaryButtonBgColor}" Foreground="{DynamicResource SecondaryButtonFgColor}" Width="80" Height="30" Margin="10,0" IsCancel="True"/>
            <Button Content="{x:Static lang:Resource.BtnCreate}" Command="{Binding DrawRebarCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="100" Height="30" Background="{DynamicResource PrimaryButtonBgColor}" Foreground="{DynamicResource PrimaryButtonFgColor}" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>