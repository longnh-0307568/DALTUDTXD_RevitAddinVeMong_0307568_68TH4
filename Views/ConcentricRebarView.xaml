<Window x:Class="AddinVeMong.Views.ConcentricRebarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Thiết lập cốt thép móng đúng tâm" Height="780" Width="850" 
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AddinVeMong;component/Resources/Styles/TextBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="CẤU HÌNH THÉP MÓNG ĐÚNG TÂM" FontSize="16" FontWeight="Bold" 
                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   HorizontalAlignment="Center" Foreground="#1565C0" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>

                <Expander Header="1. THÔNG SỐ CHUNG (MÓNG &amp; BÊ TÔNG)" IsExpanded="True" Margin="0,5" FontWeight="Bold">
                    <Grid Margin="10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Lớp bê tông bảo vệ (mm):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding Cover}" Grid.Row="0" Grid.Column="1" Margin="5,4"
                                 Tag="Mặc định: 50" Style="{StaticResource PlaceholderTextBoxStyle}" VerticalContentAlignment="Center"/>
                    </Grid>
                </Expander>

                <Expander Header="2. THÉP CẠNH DÀI (PHƯƠNG X)" IsExpanded="True" Margin="0,5" FontWeight="Bold">
                    <Grid Margin="10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Đường kính (mm):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <ComboBox SelectedValue="{Binding LongDiameter}" Grid.Row="0" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center">
                            <sys:Int32>10</sys:Int32>
                            <sys:Int32>12</sys:Int32>
                            <sys:Int32>14</sys:Int32>
                            <sys:Int32>16</sys:Int32>
                            <sys:Int32>18</sys:Int32>
                            <sys:Int32>20</sys:Int32>
                        </ComboBox>

                        <TextBlock Text="Khoảng cách a (mm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding LongSpacing}" Grid.Row="1" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Số lượng thanh:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding LongQuantity}" Grid.Row="2" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Chiều dài bẻ móc (mm):" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding LongHookLength}" Grid.Row="3" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>
                    </Grid>
                </Expander>

                <Expander Header="3. THÉP CẠNH NGẮN (PHƯƠNG Y)" IsExpanded="True" Margin="0,5" FontWeight="Bold">
                    <Grid Margin="10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Đường kính (mm):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <ComboBox SelectedValue="{Binding ShortDiameter}" Grid.Row="0" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center">
                            <sys:Int32>10</sys:Int32>
                            <sys:Int32>12</sys:Int32>
                            <sys:Int32>14</sys:Int32>
                            <sys:Int32>16</sys:Int32>
                            <sys:Int32>18</sys:Int32>
                            <sys:Int32>20</sys:Int32>
                        </ComboBox>

                        <TextBlock Text="Khoảng cách a (mm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding ShortSpacing}" Grid.Row="1" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Số lượng thanh:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding ShortQuantity}" Grid.Row="2" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Chiều dài bẻ móc (mm):" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding ShortHookLength}" Grid.Row="3" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>
                    </Grid>
                </Expander>

                <Expander Header="4. THÉP CỔ CỘT &amp; ĐAI (STARTER BARS)" IsExpanded="True" Margin="0,5" FontWeight="Bold">
                    <Grid Margin="10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Kích thước cột X (mm):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding ColumnWidthX}" Grid.Row="0" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"
                                 Tag="(Ví dụ: 220, 300)" Style="{StaticResource PlaceholderTextBoxStyle}"/>

                        <TextBlock Text="Kích thước cột Y (mm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding ColumnWidthY}" Grid.Row="1" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"
                                 Tag="(Ví dụ: 220, 400)" Style="{StaticResource PlaceholderTextBoxStyle}"/>

                        <TextBlock Text="Đường kính thép dọc:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <ComboBox SelectedValue="{Binding StarterDiameter}" Grid.Row="2" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center">
                            <sys:Int32>16</sys:Int32>
                            <sys:Int32>18</sys:Int32>
                            <sys:Int32>20</sys:Int32>
                            <sys:Int32>22</sys:Int32>
                            <sys:Int32>25</sys:Int32>
                        </ComboBox>

                        <TextBlock Text="Chiều dài chân vịt (mm):" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding StarterHookLength}" Grid.Row="3" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Chiều dài chờ cột (mm):" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding StarterLength}" Grid.Row="4" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Đường kính thép đai:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <ComboBox SelectedValue="{Binding StirrupDiameter}" Grid.Row="5" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center">
                            <sys:Int32>6</sys:Int32>
                            <sys:Int32>8</sys:Int32>
                            <sys:Int32>10</sys:Int32>
                        </ComboBox>

                        <TextBlock Text="Khoảng cách đai (mm):" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,10,0"/>
                        <TextBox Text="{Binding StirrupSpacing}" Grid.Row="6" Grid.Column="1" Margin="5,4" VerticalContentAlignment="Center"/>
                    </Grid>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Padding="10" Background="#F9F9F9" CornerRadius="5" BorderBrush="#DCDCDC" BorderThickness="1" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Mô phỏng hình chiếu đứng móng" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#333333"/>

                <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="400" Height="400" Background="White">
                        <Rectangle Canvas.Left="50" Canvas.Top="250" Width="300" Height="80" Fill="#EAEAEA" Stroke="#555555" StrokeThickness="2" ToolTip="Khối móng đơn"/>
                        <Rectangle Canvas.Left="150" Canvas.Top="130" Width="100" Height="120" Fill="#DCDCD5" Stroke="#555555" StrokeThickness="2" ToolTip="Cổ cột"/>
                        <Rectangle Canvas.Left="60" Canvas.Top="260" Width="280" Height="65" Stroke="#999999" StrokeDashArray="4,4" StrokeThickness="1"/>
                        <Path Stroke="Red" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 65,275 L 65,315 L 335,315 L 335,275" ToolTip="Thép đáy móng (Phương X)"/>
                        <Ellipse Canvas.Left="85" Canvas.Top="303" Width="8" Height="8" Fill="Blue"/>
                        <Ellipse Canvas.Left="125" Canvas.Top="303" Width="8" Height="8" Fill="Blue"/>
                        <Ellipse Canvas.Left="165" Canvas.Top="303" Width="8" Height="8" Fill="Blue"/>
                        <Ellipse Canvas.Left="205" Canvas.Top="303" Width="8" Height="8" Fill="Blue"/>
                        <Ellipse Canvas.Left="245" Canvas.Top="303" Width="8" Height="8" Fill="Blue"/>
                        <Ellipse Canvas.Left="285" Canvas.Top="303" Width="8" Height="8" Fill="Blue"/>
                        <Path Stroke="Green" StrokeThickness="4" Data="M 165,100 L 165,300 L 195,300" ToolTip="Thép chờ cổ cột"/>
                        <Path Stroke="Green" StrokeThickness="4" Data="M 235,100 L 235,300 L 205,300" ToolTip="Thép chờ cổ cột"/>
                        <Line X1="150" Y1="150" X2="250" Y2="150" Stroke="#FFA500" StrokeThickness="2"/>
                        <Line X1="150" Y1="180" X2="250" Y2="180" Stroke="#FFA500" StrokeThickness="2"/>
                        <Line X1="150" Y1="210" X2="250" Y2="210" Stroke="#FFA500" StrokeThickness="2"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="80" Height="30" Margin="10,0" IsCancel="True"/>
            <Button Content="Tạo Thép" Command="{Binding DrawRebarCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="100" Height="30" Background="#1565C0" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>