<Window x:Class="AddinVeMong.Views.AboutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin phần mềm" Height="400" Width="650" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="White">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Add-in Thiết Kế Móng" FontSize="20" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,10"/>

            <Separator Margin="0,0,0,15"/>

            <TextBlock Text="{Binding DisplayText}" 
                       FontSize="12" 
                       TextWrapping="Wrap" 
                       LineHeight="20" 
                       Foreground="#333333"/>

            <Button Content="OK" Width="80" Height="25" 
                    HorizontalAlignment="Right" Margin="0,20,0,0"
                    IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>